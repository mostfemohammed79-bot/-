import discord

TOKEN = "MTQ3MDE3MzA4OTA5NzU4NDY5Mg.Gs4e1z.lE1xR2IdOREh86lCSYx1efzgqXF-BUqDjmGk8s"

intents = discord.Intents.default()
intents.message_content = True
client = discord.Client(intents=intents)

@client.event
async def on_ready():
    print(f"البوت اشتغل: {client.user}")

@client.event
async def on_message(message):
    if message.author.bot:
        return
    if message.content == "!سبحان":
        text = "سبحان الله " * 100
        await message.channel.send(text)

client.run(TOKEN)